# Quantix Mobile Provision Service — Environment Variables
# Copy to .env and fill in real values before running

# ── Service ────────────────────────────────────────────────────────────────
PORT=3400
API_KEY=changeme-provision-secret

# ── Paths ──────────────────────────────────────────────────────────────────
# Absolute path to the Quantix-Mobile-Master repo directory
MASTER_REPO_DIR=/opt/quantix/Quantix-Mobile-Master

# Directory where tenant repos are created (sibling of MASTER_REPO_DIR)
TENANTS_DIR=/opt/quantix/tenants

# State file path (persists provisioning records across restarts)
STATE_FILE=/opt/quantix/provision-state.json

# ── GitHub ─────────────────────────────────────────────────────────────────
# Personal access token with repo + workflow scopes
GITHUB_TOKEN=ghp_...

# GitHub organisation or user to create repos under
GITHUB_ORG=quantixtechnology

# Shared submodule repo URL (passed to create_business.sh --shared-repo)
SHARED_REPO_URL=https://github.com/quantixtechnology/Quantix-Mobile-Shared.git

# ── Webhook ────────────────────────────────────────────────────────────────
# Public URL of this service (used to register GitHub webhook on new repos)
# Leave empty to skip webhook registration (CI status won't auto-update)
PROVISION_WEBHOOK_URL=https://provision.quantix.app

# GitHub webhook secret (must match the secret set when registering webhooks)
GITHUB_WEBHOOK_SECRET=changeme-webhook-secret

# ── Quantix Core back-channel ───────────────────────────────────────────────
# When set, CI build outcomes are forwarded to Core so the admin dashboard
# stays in sync without polling.
QUANTIX_CORE_URL=https://core.quantix.app
QUANTIX_CORE_WEBHOOK_SECRET=changeme-webhook-secret
