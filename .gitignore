# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android Gradle cache
android/.gradle/

# iOS CocoaPods
ios/Pods/
ios/.symlinks/

# Environment / secrets
.env
.env.*
!.env.example
!**/.env.example
*.jks
*.keystore
**/key.properties

# Firebase config — google-services.json and plist contain secrets, never commit
# firebase_options.dart is safe to commit (placeholder values; CI overwrites with real ones)
**/google-services.json
**/GoogleService-Info.plist

# VS Code settings (uncomment to exclude)
#.vscode/

# Node.js
node_modules/
**/node_modules/

# Flutter IDE metadata (machine-specific)
**/.metadata

# Tenant output directories (generated by create_business.sh, not source)
shared_backup/
